# 私有源仓库映射表：driver 所属账号 -> 要被执行的私有源仓库
#
# 格式：  <driver_owner>=<source_repo>[@<ref>]
#         <driver_owner>=none        显式声明该账号下不存在源仓库，整轮跳过
#
# 说明：
#   - source_repo 只写仓库名，不写 owner；运行时 owner 自动取 github.repository_owner
#   - 因为 4 个账号各自有一份 driver 副本，且各自用自己的 PAT 访问自己的私有仓库，
#     所以「同名不同用途」的场景天然隔离：edidada 的 driver 拉 edidada 的源，
#     wiseism 的 driver 拉 wiseism 的源。
#   - 重要：仅仅把某一行注释掉是不够的！去掉映射后会回退到内置的 cpp_ecshop 默认值，
#     runner 依然会去 checkout 一个不存在的仓库然后报错。
#     账号下确实没有该源仓库时，必须显式写 none。
#   - ref 省略时留空即用默认分支。写了 @ref 才会锁定分支，例如 cpp_ecshop@develop。
#   - 单账号定制请改在同目录的 sources.<owner>.env（overlay，优先级更高），
#     不要把差异写回本文件 —— 本文件是共享基线，由 main 分支维护。见 docs/BRANCHING.md §5。
#
# 实测状态（2026-09-25）：只有 edidada 名下存在 cpp_ecshop（private，8042KB），
# 其余三个账号该仓库均返回 404。详见 docs/REPO-MATRIX.md。

edidada=cpp_ecshop
edidadaoutlook=none
wiseism=none
wdidada126=none
